# ─────────────────────────────────────────────────────────────────────────────
# Public site config
# Canonical URLs, the sitemap and OG images are built from this.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com

# ─────────────────────────────────────────────────────────────────────────────
# "Start a Project" enquiries (the form in the Contact section)
# Email: create a free account at https://resend.com with the address below,
# then paste an API key. Without a verified domain, Resend's test sender can
# only deliver to the account owner's own address — which is all this needs.
# Optional: INQUIRY_FROM="Portfolio <hello@yourdomain.com>" once a domain is verified.
# A webhook (Slack, Discord, Zapier, …) can be used instead or as well.
# With nothing configured, production returns an error so enquiries are never
# silently lost; development just logs them.
# ─────────────────────────────────────────────────────────────────────────────
INQUIRY_NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=
INQUIRY_FROM=
INQUIRY_WEBHOOK_URL=
