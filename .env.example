# ─────────────────────────────────────────────────────────────────────────────
# Public site config
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com

# ─────────────────────────────────────────────────────────────────────────────
# AI Portfolio Assistant  ("ASK RYAN'S AI")
# Leave ASSISTANT_PROVIDER unset or = "mock" to use the built-in mock answers
# in src/data/assistant.ts. Set to "anthropic" or "openai" to use a real model.
# ─────────────────────────────────────────────────────────────────────────────
ASSISTANT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: point at your own RAG / retrieval service instead of a raw model.
# When set, /api/assistant POSTs { question } here and expects { answer, sources }.
ASSISTANT_RAG_ENDPOINT=
ASSISTANT_RAG_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# "Start a project" inquiries
# Without these, submissions are logged server-side only (see
# src/app/api/inquiry/route.ts) — wire one up before going live.
# ─────────────────────────────────────────────────────────────────────────────
INQUIRY_WEBHOOK_URL=
INQUIRY_NOTIFY_EMAIL=
